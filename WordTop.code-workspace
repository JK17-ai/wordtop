{
  "folders": [{ "name": "WordTop", "path": "." }],
  "extensions": { "recommendations": ["openai.chatgpt"] },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      { "label": "WordTop: Dev", "type": "shell", "command": "npm.cmd", "args": ["run", "dev", "--", "--host", "127.0.0.1"], "options": { "cwd": "${workspaceFolder}/frontend" }, "isBackground": true, "problemMatcher": [] },
      { "label": "WordTop: Build", "type": "shell", "command": "npm.cmd", "args": ["run", "build"], "options": { "cwd": "${workspaceFolder}/frontend" }, "group": "build", "problemMatcher": [] },
      { "label": "WordTop: Lint", "type": "shell", "command": "npm.cmd", "args": ["run", "lint"], "options": { "cwd": "${workspaceFolder}/frontend" }, "problemMatcher": [] }
    ]
  }
}